# Copy this file to .env and adjust values as needed

# Flask secret key (used for session signing)
SECRET_KEY=change-this-secret-key-in-production

# Admin key required for all admin-protected endpoints (send as header: X-Admin-Key)
ADMIN_KEY=admin123

# Database URI (SQLite by default)
DATABASE_URI=sqlite:///campuscare.db

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
